---
import { SITE } from '../consts';
import { url } from '../lib/utils';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  /** 文章页传入发布日期，用于 Open Graph */
  pubDate?: Date;
  /** 文章页传入标签 */
  tags?: string[];
}

const {
  title,
  description = SITE.tagline,
  pubDate,
  tags = [],
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;

const nav = [
  { href: url('/'), label: '首页' },
  { href: url('/blog/'), label: '随笔' },
  { href: url('/work/'), label: '工作经验' },
  { href: url('/products/'), label: '产品' },
  { href: url('/learn/'), label: '学习笔记' },
  { href: url('/about/'), label: '关于' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={url('/rss.xml')} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={pubDate ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="zh_CN" />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#2f6f4e" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
  </head>

  <body>
    <header class="site-header">
      <div class="wrap wrap-wide inner">
        <a class="brand" href={url('/')}>{SITE.title}</a>
        <nav class="nav" aria-label="主导航">
          {
            nav.map((item) => {
              const isCurrent =
                item.href.replace(/\/$/, '') === currentPath ||
                (item.href !== url('/') && currentPath.startsWith(item.href.replace(/\/$/, '')));
              return (
                <a href={item.href} aria-current={isCurrent ? 'page' : undefined}>
                  {item.label}
                </a>
              );
            })
          }
        </nav>
      </div>
    </header>

    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap wrap-wide inner">
        <span>© {new Date().getFullYear()} {SITE.author} · 用 Astro 构建，托管于 GitHub Pages</span>
        <span class="footer-links">
          <a href={url('/rss.xml')}>RSS</a>
          <a href={url('/blog/')}>全部文章</a>
          <a href={url('/about/')}>关于本站</a>
        </span>
      </div>
    </footer>
  </body>
</html>
